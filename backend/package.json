{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend quản lý ký túc xá — Express + TypeScript + Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "create-admin": "tsx --env-file=.env prisma/create-admin.ts",
    "seed:tai": "tsx --env-file=.env.tai prisma/seed-tai.ts",
    "start:tai": "node --env-file=.env.tai dist/server.js",
    "test": "vitest run"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@auth/express": "^0.12.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
