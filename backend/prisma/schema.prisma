// Thiết kế CSDL — xem docs/database.md để biết lý do đằng sau từng quyết định.
//
// Điểm khác thiết kế thông thường:
//   - Manager ↔ tòa là quan hệ 1–1 (User.buildingId @unique): mỗi Manager
//     quản lý đúng 1 tòa, mỗi tòa có tối đa 1 Manager. Admin không gắn tòa nào
//     và thao tác được mọi tòa. Mọi kiểm tra phạm vi quyền dựa vào cột này —
//     xem src/utils/scope.ts.
//
// Nguyên tắc snapshot: dữ liệu đã chốt không đổi theo bảng danh mục.
//   - Contract.price        copy từ RoomType.price lúc tạo hợp đồng
//   - InvoiceItem.unitPrice copy từ đơn giá điện/nước lúc chốt hóa đơn
//   Nhờ vậy sửa giá phòng / đơn giá điện nước không hồi tố dữ liệu cũ.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Unique index có điều kiện — chặn 2 hợp đồng cùng giữ một giường (model Contract).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED // hợp đồng ĐANG Ở bị kết thúc trước hạn
  CANCELLED // hợp đồng CHỜ KÝ bị hủy (SV từ chối ký / Manager hủy) — chưa từng có hiệu lực
}

// OVERDUE không có ở đây — tính khi đọc: dueDate < now && status = UNPAID
enum InvoiceStatus {
  UNPAID
  PAID
}

enum InvoiceType {
  ROOM_FEE
  UTILITY
}

enum InvoiceItemType {
  ROOM_FEE
  ELECTRIC
  WATER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RequestStatus {
  PENDING
  RECEIVED
  IN_PROGRESS
  DONE
  CONFIRMED
  REJECTED
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role    @default(STUDENT)
  isActive     Boolean @default(true)

  // Chỉ dùng cho MANAGER: tòa được gán. Mọi kiểm tra phạm vi quyền dựa vào cột này.
  // @unique: mỗi tòa tối đa 1 Manager (NULL không tính trùng — Admin, SV, Manager chưa gán).
  buildingId String?   @unique
  building   Building? @relation(fields: [buildingId], references: [id])

  profile        StudentProfile?
  registrations  Registration[]
  requests       MaintenanceRequest[]
  endedContracts Contract[]         @relation("ContractEndedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  studentCode String    @unique
  gender      Gender
  dob         DateTime?
  className   String?
  faculty     String?
  hometown    String?
  citizenId   String?
}

model Building {
  id          String  @id @default(uuid())
  name        String  @unique
  floors      Int
  gender      Gender? // null = tòa hỗn hợp
  description String?
  isActive    Boolean @default(true)

  rooms   Room[]
  manager User? // quan hệ 1–1, phía giữ khóa là User.buildingId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Danh mục loại phòng — dùng chung toàn hệ thống, không gắn theo tòa.
// Sức chứa và giá nằm ở đây để hai phòng cùng loại không thể lệch giá nhau.
model RoomType {
  id          String  @id @default(uuid())
  name        String  @unique // "Phòng 4 giường - điều hòa"
  capacity    Int // số giường chuẩn
  price       Decimal @db.Decimal(12, 0) // giá/kỳ cho 1 sinh viên
  description String?
  isActive    Boolean @default(true)

  rooms         Room[]
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  code       String
  floor      Int
  isActive   Boolean  @default(true)

  beds     Bed[]
  requests MaintenanceRequest[]
  hygiene  HygieneRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, code])
}

model Bed {
  id     String    @id @default(uuid())
  roomId String
  room   Room      @relation(fields: [roomId], references: [id])
  code   String
  status BedStatus @default(AVAILABLE)

  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, code])
}

model RegistrationPeriod {
  id      String   @id @default(uuid())
  name    String
  // Thời gian NHẬN ĐƠN — chỉ để thông báo; mở/đóng thật sự do isOpen quyết định.
  startAt DateTime
  endAt   DateTime
  isOpen  Boolean  @default(false) // Admin bật/tắt tay, không tự đóng theo endAt
  // Thời gian Ở của đợt (học kỳ) — hợp đồng sinh từ đợt này lấy kỳ hạn ở đây.
  stayStartAt DateTime
  stayEndAt   DateTime
  // Mã học kỳ "2026-HK1" | "2026-HK2" | "2026-HE" (năm = năm bắt đầu năm học).
  // Thành Invoice.period của hóa đơn tiền phòng khi sinh viên ký hợp đồng.
  // Không unique: một học kỳ có thể có nhiều đợt (đợt chính + đợt bổ sung).
  term        String

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Registration {
  id        String             @id @default(uuid())
  periodId  String
  period    RegistrationPeriod @relation(fields: [periodId], references: [id])
  studentId String
  student   User               @relation(fields: [studentId], references: [id])

  // Nguyện vọng tòa — cố ý để dạng scalar, không ràng buộc khóa ngoại
  buildingId          String?
  // Nguyện vọng loại phòng — có khóa ngoại vì RoomType là danh mục ổn định
  preferredRoomTypeId String?
  preferredRoomType   RoomType? @relation(fields: [preferredRoomTypeId], references: [id])
  note                String?

  status       RegistrationStatus @default(PENDING)
  reviewedById String?
  reviewNote   String?
  contract     Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id             String       @id @default(uuid())
  code           String       @unique
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id])
  bedId          String
  bed            Bed          @relation(fields: [bedId], references: [id])

  startDate DateTime
  endDate   DateTime
  price     Decimal        @db.Decimal(12, 0) // snapshot từ RoomType.price lúc tạo
  status    ContractStatus @default(DRAFT)

  signedAt          DateTime?
  // Kết thúc sớm — chấm dứt (TERMINATED) hoặc hủy khi còn chờ ký (CANCELLED).
  // Lý do bắt buộc (kiểm tra ở service); endedBy cho biết SV tự từ chối hay Manager hủy.
  terminatedAt      DateTime?
  terminationReason String?
  endedById         String?
  endedBy           User?     @relation("ContractEndedBy", fields: [endedById], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Một giường tại một thời điểm chỉ có tối đa 1 hợp đồng đang giữ (DRAFT chờ ký
  // hoặc ACTIVE đang ở). Lớp chặn cuối ở database cho tranh chấp giường: 2 lệnh
  // duyệt song song lọt qua kiểm tra ở service thì lệnh sau vẫn vỡ ở đây (P2002).
  // Điều kiện viết đúng dạng Postgres tự chuẩn hóa (`IN (...)` → `= ANY (ARRAY[...])`),
  // viết kiểu khác thì mỗi lần `migrate dev` Prisma lại tưởng lệch và đòi tạo lại index.
  @@unique([bedId], map: "Contract_bedId_holding_key", where: raw("(status = ANY (ARRAY['DRAFT'::\"ContractStatus\", 'ACTIVE'::\"ContractStatus\"]))"))
}

model Invoice {
  id         String      @id @default(uuid())
  code       String      @unique
  contractId String
  contract   Contract    @relation(fields: [contractId], references: [id])
  type       InvoiceType

  // Bắt buộc, kể cả ROOM_FEE — "2026-09" (điện nước) | "2026-HK1" (tiền phòng).
  // Để nullable thì @@unique bên dưới vô hiệu, vì Postgres coi mọi NULL là khác nhau.
  period String

  amount  Decimal       @db.Decimal(12, 0) // = SUM(items.amount), chốt lúc tạo
  dueDate DateTime
  status  InvoiceStatus @default(UNPAID)

  // Số sinh viên chia hóa đơn tại thời điểm chốt — chỉ dùng khi type = UTILITY.
  // Lưu lại để về sau vẫn giải thích được con số đã tính.
  splitCount Int?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, type, period])
}

// Dòng chi tiết hóa đơn. ROOM_FEE có 1 dòng, UTILITY có 2 dòng (điện + nước).
// Lý do tách bảng: unitPrice phải được snapshot — đơn giá điện nước nằm trong
// constants.ts, sửa hằng số đó không được phép làm hóa đơn cũ giải thích sai.
model InvoiceItem {
  id        String          @id @default(uuid())
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      InvoiceItemType

  oldIndex  Int? // chỉ số cũ — chỉ ELECTRIC/WATER
  newIndex  Int? // chỉ số mới — chỉ ELECTRIC/WATER
  quantity  Decimal @db.Decimal(12, 2) // kWh / m³ của CẢ PHÒNG (ROOM_FEE = 1)
  unitPrice Decimal @db.Decimal(12, 0) // snapshot đơn giá lúc chốt
  amount    Decimal @db.Decimal(12, 0) // phần của SV này = quantity * unitPrice / splitCount

  createdAt DateTime @default(now())

  @@unique([invoiceId, type])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(12, 0)
  status    PaymentStatus @default(PENDING)

  txnRef           String    @unique // = payment.id, gửi làm vnp_TxnRef
  vnpTransactionNo String?
  vnpResponseCode  String? // "00" = thành công
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceRequest {
  id          String        @id @default(uuid())
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])
  studentId   String
  student     User          @relation(fields: [studentId], references: [id])
  title       String
  description String
  status      RequestStatus @default(PENDING)

  assigneeNote String?
  handledById  String?
  doneAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HygieneRecord {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  checkDate DateTime
  score     Int // 0-100
  deduction Int      @default(0)
  note      String?

  checkedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
