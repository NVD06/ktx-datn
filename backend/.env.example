# Database
DATABASE_URL=

# Auth.js — tạo chuỗi ngẫu nhiên bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Server — bỏ NODE_ENV thì mặc định là production (ẩn chi tiết lỗi 500)
NODE_ENV=development
PORT=3000

# VNPay sandbox — mã và khóa lấy trong email đăng ký merchant thử nghiệm.
# RETURN_URL đi qua cổng của frontend (Vite chuyển /api sang backend), trên bản deploy là
# https://ktxphe.id.vn/api/v1/payments/vnpay-return. IPN URL khai báo ở trang quản trị VNPay.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/api/v1/payments/vnpay-return
